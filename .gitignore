/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# claude
.claude
.agents

/docs/*

.mcp.json

# Playwright
node_modules/
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
/playwright/.auth/

# E2E storageState — 세션 쿠키가 실 토큰이다. 절대 커밋하지 않는다.
tests/.auth/

# superpowers brainstorm mockups
.superpowers/

# .env.example은 더미 값만 담는다 — 커밋한다
!.env.example

# supabase
supabase/.branches
supabase/.temp

# 생성물이다(scripts/gen-seed.ts). 날짜를 dayOffset()으로 "오늘" 기준 상대값으로 찍으므로
# 커밋해 두면 하루만 지나도 stale해진다 — `npm run db:reset`이 매번 seed:gen을 먼저 돌려
# 그날 값으로 다시 만든다. 로컬에만 있으면 된다.
supabase/seed.sql
