# 공개 사이트 URL — OG/트위터 이미지를 절대 URL로 만드는 데 쓴다(app/layout.tsx의 metadataBase).
# 설정하지 않으면 Vercel의 VERCEL_URL, 그것도 없으면 http://localhost:3000으로 폴백한다.
# 프로덕션에서는 반드시 실제 도메인을 넣는다 — 안 그러면 공유 미리보기 이미지가 깨진다.
NEXT_PUBLIC_SITE_URL=https://example.com

# 뷰어 비밀번호 통과 쿠키(planit_unlock_<slug>)에 서명하는 키.
# 프로덕션에서는 반드시 설정한다 — 없으면 서버가 부팅 시 에러를 던진다.
# 개발에서는 고정 폴백을 쓴다(액션 코드 참고).
VIEWER_SECRET=replace-me-with-a-long-random-string

# Supabase. 로컬은 `npx supabase start`가 출력하는 값을 .env.local에 넣는다.
# 서비스 롤 키는 NEXT_PUBLIC_ 접두사를 절대 붙이지 않는다 — 클라이언트 번들에 들어간다.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-me
SUPABASE_SERVICE_ROLE_KEY=replace-me
